{% extends 'app.twig' %}
{% block title %}{{ t('nav.oldmetal') }}{% endblock %}
{% block heading %}{{ t('nav.oldmetal') }}{% endblock %}

{% block content %}
<div class="page-head">
    <div><h1>{{ t('nav.oldmetal') }}</h1><p class="muted">Old gold and silver taken from customers, and raw metal bought for stock.</p></div>
    <div class="actions">
        {% if can('oldMetal.create') %}
            <button class="btn btn-primary" type="button" hx-get="/old-metal/new?kind=old" hx-target="#modal-body">{{ icon('plus', 17) }} Receive old metal</button>
            <button class="btn" type="button" hx-get="/old-metal/new?kind=raw" hx-target="#modal-body">Buy raw metal</button>
        {% endif %}
    </div>
</div>
<div class="live-block" hx-get="/old-metal/list" hx-trigger="load, data-changed from:body" hx-swap="innerHTML">
    <div class="loading"><span class="spinner"></span></div>
</div>
{% endblock %}
