{% import 'ui.twig' as ui %}
<form hx-post="/expenses" hx-target="#modal-body" hx-swap="innerHTML" class="modal-form">
    {{ csrf_field() }}
    <h2>Add expense</h2>
    {% if error %}<div class="notice notice-error" role="alert">{{ error }}</div>{% endif %}
    <div class="form-grid">
        <div class="span-2">{{ ui.field('Amount', 'amount', v.amount|default(''), {type: 'number', step: '0.01', min: '0', money: true, required: true, autofocus: true, inputmode: 'decimal'}) }}</div>
        {{ ui.field('What for', 'category', v.category|default('Other'), {type: 'select', options: categories}) }}
        {{ ui.field('Paid by', 'mode', v.mode|default('Cash'), {type: 'select', options: modes}) }}
        {{ ui.field('Date', 'date', v.date|default('now'|date('Y-m-d')), {type: 'date', max: 'now'|date('Y-m-d')}) }}
        {{ ui.field('Note (optional)', 'note', v.note|default(''), {}) }}
    </div>
    <div class="modal-actions">
        <button type="button" class="btn" data-close-modal>{{ t('common.cancel') }}</button>
        <button type="submit" class="btn btn-primary">Save expense</button>
    </div>
</form>
