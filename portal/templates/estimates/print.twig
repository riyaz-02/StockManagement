<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ e.number }} · Estimate</title>
    <link rel="stylesheet" href="{{ asset('css/print.css') }}">
    <script src="{{ asset('js/print.js') }}" defer></script>
</head>
<body>
<div class="bar no-print"><button type="button" data-print>Print / save as PDF</button><a href="/estimates/{{ e.id }}">Back</a></div>
<main class="sheet">
    <header class="head">
        <div><h1>{{ seller.firmName }}</h1><p>{{ seller.address }}</p><p>Phone: {{ seller.phone }}</p></div>
        <div class="tag"><strong>ESTIMATE</strong><span>NOT A TAX INVOICE</span></div>
    </header>
    <section class="cols">
        <div><h3>For</h3><p><strong>{{ e.customerName }}</strong></p>{% if e.customerMobile %}<p>Mobile: {{ e.customerMobile }}</p>{% endif %}</div>
        <div class="right"><p>Estimate no: <strong>{{ e.number }}</strong></p><p>Date: <strong>{{ e.date|dmy }}</strong></p><p>Valid till: <strong>{{ e.validTill|dmy }}</strong></p><p>Gold {{ e.goldRate|inr(0) }} · Silver {{ e.silverRate|inr(0) }} per gram</p></div>
    </section>
    <table class="items">
        <thead><tr><th>#</th><th>Description</th><th class="n">Net wt (g)</th><th class="n">Rate</th><th class="n">Making</th><th class="n">Taxable</th><th class="n">Total with GST</th></tr></thead>
        <tbody>{% for i in e.items %}
            <tr><td>{{ loop.index }}</td><td>{{ i.particulars }}{% if i.purity is defined and i.purity %} ({{ i.purity }}){% endif %}</td><td class="n">{{ '%.3f'|format(i.net_wt) }}</td><td class="n">{{ i.rate|inr }}</td><td class="n">{{ i.making_charge|inr }}</td><td class="n">{{ i.taxable_amount|inr }}</td><td class="n">{{ i.total|inr }}</td></tr>
        {% endfor %}</tbody>
    </table>
    <section class="cols end">
        <div>{% if e.note %}<p>{{ e.note }}</p>{% endif %}<p class="muted">Rates change every day: the price holds only until {{ e.validTill|dmy }}. GST 3% is included. This is a quotation, not a tax invoice.</p></div>
        <table class="sum">
            {% if e.totals.discount > 0 %}<tr><td>Discount</td><td class="n">− {{ e.totals.discount|inr }}</td></tr>{% endif %}
            <tr class="grand"><td>Estimate total</td><td class="n">{{ e.totals.payable|inr(0) }}</td></tr>
        </table>
    </section>
</main>
</body>
</html>
