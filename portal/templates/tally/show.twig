{% extends 'app.twig' %}
{% block title %}{{ s.description }}{% endblock %}
{% block heading %}Stock Tally{% endblock %}

{% block content %}
<div class="page-head">
    <div>
        <h1>{{ s.description }} {% if locked %}<span class="pill pill-{{ s.status == 'locked' ? 'green' : 'amber' }}">{{ s.status == 'locked' ? 'Complete' : 'Locked with items missing' }}</span>{% else %}<span class="pill pill-blue">In progress</span>{% endif %}</h1>
        <p class="muted">Started {{ s.createdAt|dmy_time }}{% if s.createdBy.name|default('') %} by {{ s.createdBy.name }}{% endif %}{% if locked and s.lockedAt %} · locked {{ s.lockedAt|dmy_time }}{% endif %}</p>
    </div>
    <div class="actions">
        {% if not locked and can('tally.lock') %}<button class="btn btn-ok" type="button" hx-get="/tally/{{ s._id }}/lock" hx-target="#modal-body">Finish and lock</button>{% endif %}
        <a class="btn" href="/tally">All tallies</a>
    </div>
</div>

{% if not locked and can('tally.scan') %}
<section class="panel">
    <div class="panel-head"><h2>Scan a piece</h2></div>
    <div class="panel-body">
        <form hx-post="/tally/{{ s._id }}/scan" hx-target="#scan-result" hx-swap="innerHTML" class="scan-form" data-reset-after>
            {{ csrf_field() }}
            <input type="text" name="barcode" placeholder="Scan the barcode, or type it and press Enter" autocomplete="off" autofocus>
            <button class="btn btn-primary" type="submit">Check</button>
        </form>
        <div id="scan-result" aria-live="polite"></div>
    </div>
</section>
{% endif %}

<div class="live-block" hx-get="/tally/{{ s._id }}/panel" hx-trigger="load, data-changed from:body, tally-scanned from:body" hx-swap="innerHTML">
    <div class="loading"><span class="spinner"></span></div>
</div>
{% endblock %}
