{% extends 'app.twig' %}
{% block title %}{{ t('nav.' ~ item.key) }}{% endblock %}
{% block heading %}{{ t('nav.' ~ item.key) }}{% endblock %}

{% block content %}
<div class="empty-page">
    <div class="empty-ico">{{ icon(item.icon, 40) }}</div>
    <h1>{{ t('nav.' ~ item.key) }}</h1>
    <h2>{{ t('soon.title') }}</h2>
    <p class="muted">{{ t('soon.text') }}</p>
    <a class="btn btn-primary" href="/">{{ t('common.back_home') }}</a>
</div>
{% endblock %}
