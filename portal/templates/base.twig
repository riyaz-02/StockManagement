<!doctype html>
<html lang="{{ 'en' }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"422","swap":true,"error":false},{"code":"[45]..","swap":false,"error":true}]}'>
    <meta name="csrf" content="{{ csrf() }}">
    <title>{% block title %}{{ app_name() }}{% endblock %} · {{ app_name() }}</title>
    <link rel="icon" href="{{ asset('img/logo.png') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('css/kit.css') }}">
    <link rel="stylesheet" href="{{ asset('css/compact.css') }}">
    <script src="{{ asset('js/htmx.min.js') }}" defer></script>
    <script src="{{ asset('js/app.js') }}" defer></script>
    <script src="{{ asset('js/customer-form.js') }}" defer></script>
    <script src="{{ asset('js/alpine.min.js') }}" defer></script>
    {% block head_extra %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}"{% block body_attrs %}{% endblock %}>
{% block body %}{% endblock %}
<div id="toasts" class="toasts" aria-live="polite"></div>
</body>
</html>
