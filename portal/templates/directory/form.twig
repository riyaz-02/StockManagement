{% extends 'app.twig' %}
{% import 'ui.twig' as ui %}
{% set editing = id is not null %}
{% block title %}{{ editing ? 'Edit customer' : 'New customer' }}{% endblock %}
{% block heading %}{{ editing ? 'Edit customer' : 'New customer' }}{% endblock %}

{% block content %}
<div class="page-head"><div><h1>{{ editing ? 'Edit ' ~ v.name|default('customer') : 'New customer' }}</h1><p class="muted">Only the details below are changed. Everything else saved for this customer stays as it is.</p></div></div>
<form method="post" action="{{ editing ? '/directory/customers/' ~ id : '/directory/customers' }}" class="grid" novalidate>
    {{ csrf_field() }}
    {% if editing %}<input type="hidden" name="expectedUpdatedAt" value="{{ v.expectedUpdatedAt|default('') }}">{% endif %}
    {% if error %}<div class="notice notice-error" role="alert">{{ error }}</div>{% endif %}
    {% if canForce %}<label class="check notice notice-info"><input type="checkbox" name="force" value="1"> <span>This number already belongs to another customer. Tick to save anyway.</span></label>{% endif %}
    <section class="panel"><div class="panel-head"><h2>Who</h2></div><div class="panel-body"><div class="form-grid">
        {{ ui.field('Name', 'name', v.name|default(''), {required: true, span: true}) }}
        {{ ui.field('Name in Bengali (optional)', 'nameBengali', v.nameBengali|default(''), {span: true}) }}
        {{ ui.field('Mobile / WhatsApp', 'phone1', v.phone1|default(''), {required: true, inputmode: 'numeric', type: 'tel'}) }}
        {{ ui.field('Second mobile (optional)', 'phone2', v.phone2|default(''), {inputmode: 'numeric', type: 'tel'}) }}
        {{ ui.field('Email (optional)', 'email', v.email|default(''), {type: 'email'}) }}
        {{ ui.field('Customer type', 'membershipStatus', v.membershipStatus|default('Regular'), {type: 'select', options: ['Regular', 'VIP']}) }}
    </div></div></section>
    <section class="panel"><div class="panel-head"><h2>Address and tax</h2></div><div class="panel-body"><div class="form-grid">
        {{ ui.field('Address', 'address', v.address|default(''), {span: true}) }}
        {{ ui.field('City', 'city', v.city|default(''), {}) }}
        {{ ui.field('State', 'state', v.state|default(''), {}) }}
        {{ ui.field('Pincode', 'pincode', v.pincode|default(''), {inputmode: 'numeric'}) }}
        {{ ui.field('PAN', 'panNo', v.panNo|default(''), {}) }}
        {{ ui.field('GSTIN (if they have one)', 'gstNo', v.gstNo|default(''), {}) }}
        {{ ui.field('Note', 'notes', v.notes|default(''), {span: true}) }}
    </div></div></section>
    <div class="sticky-actions"><a class="btn" href="{{ editing ? '/directory/customers/' ~ id : '/directory' }}">{{ t('common.cancel') }}</a><button class="btn btn-primary" type="submit">Save</button></div>
</form>
{% endblock %}
