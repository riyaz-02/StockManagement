{% extends 'app.twig' %}
{% block title %}{{ t('home.title') }}{% endblock %}
{% block heading %}{{ t('home.title') }}{% endblock %}

{% block content %}
<section class="hello">
    <div>
        <h1>{{ t('home.hello', {name: user().name}) }}</h1>
        <p class="muted">{{ t('home.today') }}</p>
    </div>
</section>

<div id="dashboard" hx-get="/partials/dashboard" hx-trigger="load, refresh, data-changed from:body" hx-swap="innerHTML">
    <div class="cards">
        {% for i in 1..4 %}<div class="card skeleton"><i></i><i></i></div>{% endfor %}
    </div>
</div>

<section class="quick">
    <h2>{{ t('home.quick') }}</h2>
    <div class="quick-grid">
        {# a real page to go straight to; a pop-up form opens in place instead #}
        {% macro q(key, label, href = null, popup = null) %}
            {% set m = nav_meta(key) %}
            <a class="quick-item" href="{{ href ?: '#' }}"{% if popup %} hx-get="{{ popup }}" hx-target="#modal-body"{% endif %}><span class="quick-ico" style="--m: {{ m.color }}">{{ icon(m.icon, 18) }}</span><span>{{ label }}</span></a>
        {% endmacro %}
        {% if can('billing.create') %}{{ _self.q('billing', 'New bill', '/billing/new') }}{% endif %}
        {% if can('estimates.create') %}{{ _self.q('estimates', 'New estimate', '/estimates/new') }}{% endif %}
        {% if can('orders.create') %}{{ _self.q('orders', 'New order', '/orders/new') }}{% endif %}
        {% if can('expenses.create') %}{{ _self.q('expenses', 'Add expense', null, '/expenses/new') }}{% endif %}
        {% if can('oldMetal.create') %}{{ _self.q('oldmetal', 'Old metal', null, '/old-metal/new?kind=old') }}{% endif %}
        {% if can('items.create') %}{{ _self.q('stock', 'Add stock', '/stock/new') }}{% endif %}
    </div>
</section>
{% endblock %}
