{% extends 'base.twig' %}
{% block title %}{{ t('login.title') }}{% endblock %}
{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="login2">
    <section class="login2-art" data-login-slider aria-hidden="true">
        {% for s in slides|default([]) %}<img class="login2-slide{{ loop.first ? ' is-on' : '' }}" src="{{ s.imageUrl }}" alt="" decoding="async"{{ loop.first ? '' : ' loading="lazy"' }}>{% endfor %}
        {% if slides|default([])|length > 1 %}<div class="login2-dots">{% for s in slides %}<i{{ loop.first ? ' class="is-on"' : '' }}></i>{% endfor %}</div>{% endif %}
    </section>
    <section class="login2-panel">
        <form method="post" action="/login" class="login2-card" x-data="passwordField" autocomplete="on">
            {{ csrf_field() }}
            <img src="{{ asset('img/logo.png') }}" alt="{{ app_name() }}" class="login2-logo">
            {% if flash %}<div class="notice notice-{{ flash.type }}" role="alert">{{ flash.text }}</div>{% endif %}
            <input type="text" name="mobile" autocomplete="username" autocapitalize="off" spellcheck="false" maxlength="80" value="{{ mobile }}" placeholder="{{ t('login.mobile') }}" aria-label="{{ t('login.mobile') }}" required autofocus>
            <div class="login2-pass">
                <input :type="type" name="password" autocomplete="current-password" placeholder="{{ t('login.password') }}" aria-label="{{ t('login.password') }}" required>
                <button type="button" class="link-btn" @click="toggle" x-text="label"></button>
            </div>
            <button class="btn btn-primary btn-block" type="submit">{{ t('login.button') }}</button>
        </form>
    </section>
</div>
{% endblock %}
