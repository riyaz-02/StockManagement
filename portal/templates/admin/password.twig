{% import 'ui.twig' as ui %}
<form hx-post="/admin/staff/{{ u._id }}/password" hx-target="#modal-body" hx-swap="innerHTML" class="modal-form">
    {{ csrf_field() }}
    <h2>New password</h2>
    <p class="muted">For {{ u.name }} ({{ u.mobile }}). Their old password stops working at once.</p>
    {% if error %}<div class="notice notice-error" role="alert">{{ error }}</div>{% endif %}
    <div class="form-grid">
        <div class="span-2">{{ ui.field('New password (6 or more)', 'password', '', {required: true, autofocus: true}) }}</div>
        <div class="span-2">{{ ui.field('Type it again', 'again', '', {required: true}) }}</div>
    </div>
    <div class="modal-actions">
        <button type="button" class="btn" data-close-modal>{{ t('common.cancel') }}</button>
        <button type="submit" class="btn btn-primary">Change password</button>
    </div>
</form>
