{% if more %}{% include 'purchases/rows.twig' %}{% else %}
<form class="toolbar" hx-get="/purchases/list" hx-target="closest .live-block" hx-swap="innerHTML" hx-trigger="input changed delay:300ms from:find input[type=search], change from:find select, change from:find input[type=date], submit">
    <select name="metal" aria-label="Metal">
        <option value="">All metals</option>
        {% for m in ['gold', 'silver'] %}<option value="{{ m }}"{{ metal == m ? ' selected' : '' }}>{{ m|capitalize }}</option>{% endfor %}
    </select>
    <div class="search grow">{{ icon('search', 17) }}<input type="search" name="q" value="{{ q }}" placeholder="Search supplier" autocomplete="off"></div>
    <input type="date" name="from" value="{{ from }}" aria-label="From">
    <span class="muted">to</span>
    <input type="date" name="to" value="{{ to }}" aria-label="To">
</form>
<div class="stats">
    {% for m in ['gold', 'silver'] %}{% set t = totals[m]|default({}) %}
        <div class="stat"><span>{{ m|capitalize }} bought</span><strong>{{ t.totalWeight|default(0)|grams }}</strong><small>{{ t.count|default(0) }} bills · {{ t.totalAmount|default(0)|inr(0) }}</small></div>
    {% endfor %}
</div>
<section class="panel">
    {% if rows|length %}
    <div class="table-wrap"><table class="t">
        <thead><tr><th>Bill</th><th>Supplier</th><th>Metal</th><th class="num">Weight</th><th class="num">Amount</th><th class="num hide-sm">GST</th><th class="num">Payable</th></tr></thead>
        <tbody>{% include 'purchases/rows.twig' %}</tbody>
    </table></div>
    {% else %}<div class="t-empty">No purchases found.</div>{% endif %}
</section>
{% endif %}
