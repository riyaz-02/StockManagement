<form hx-post="/rates" hx-target="#modal-body" hx-swap="innerHTML" class="modal-form">
    {{ csrf_field() }}
    <h2>{{ t('rate.title') }}</h2>
    <p class="muted">{{ t('rate.help') }}</p>
    {% if error %}<div class="notice notice-error" role="alert">{{ error }}</div>{% endif %}
    <label class="field">
        <span>{{ t('rate.gold') }}</span>
        <input type="number" name="gold" step="0.01" min="0" inputmode="decimal" value="{{ rate.gold|default(0) > 0 ? rate.gold : '' }}" autofocus>
    </label>
    <label class="field">
        <span>{{ t('rate.silver') }}</span>
        <input type="number" name="silver" step="0.01" min="0" inputmode="decimal" value="{{ rate.silver|default(0) > 0 ? rate.silver : '' }}">
    </label>
    <div class="modal-actions">
        <button type="button" class="btn" data-close-modal>{{ t('common.cancel') }}</button>
        <button type="submit" class="btn btn-primary">{{ t('rate.save') }}</button>
    </div>
</form>
