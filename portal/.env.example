# Copy to .env (never commit .env)
# dev | prod
PORTAL_ENV=dev
# prod: https://api.laltuguineapalace.com
PORTAL_API_BASE=http://localhost:5000
# prod: the Lambda function URL that starts the server (leave empty in dev)
PORTAL_WAKE_URL=
PORTAL_SESSION_NAME=lgp_portal
# sign out after this many minutes without activity
PORTAL_IDLE_MINUTES=480
PORTAL_APP_NAME=Laltu Guinea Palace

# Same long random text as PORTAL_SHARED_KEY in the API's .env: lets the API rate-limit each visitor separately (not all staff together)
PORTAL_SHARED_KEY=
