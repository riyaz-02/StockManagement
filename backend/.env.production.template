# PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env.production and fill in your production values
# NEVER commit .env.production to version control!

# Environment
NODE_ENV=production
PORT=5000

# MongoDB Connection: the ONE database, used by the app, the new website and the old website (the production cluster's `shopmanage`).
# It MUST end with the database name. There is no other database address (SHOPMANAGE_DB_URI / LGP_ADMIN_DB_URI were removed).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopmanage?retryWrites=true&w=majority

# JWT Configuration
# Generate a strong secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRE=7d
# a phone that signs in from the app (remember:true) or refreshes keeps a long session; its PIN / fingerprint guard the screen
JWT_REMEMBER_EXPIRE=90d

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Amazon S3 (new uploads: photos, PDFs, videos). On EC2 there are NO keys here: the instance's IAM role is used.
# See docs/S3_SETUP.md. Without S3_BUCKET, uploads keep going to Cloudinary.
S3_BUCKET=
S3_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=https://files.example.com   (only if a CloudFront address is put in front of the bucket)

# Cloudinary Configuration (the existing pictures; also the fallback until S3_BUCKET is set)
CLOUDINARY_CLOUD_NAME=your_production_cloud_name
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret

# CORS Configuration
# Mobile apps usually send no Origin header; keep this for browser/admin clients.
CORS_ORIGIN=https://api.laltuguineapalace.com

# Optional EC2 cost saver
# On EC2, set instance-initiated shutdown behavior to "stop", then enable:
# AUTO_STOP_AFTER_IDLE_MINUTES=25
# AUTO_STOP_COMMAND=sudo /sbin/shutdown -h now
AUTO_STOP_AFTER_IDLE_MINUTES=
AUTO_STOP_COMMAND=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Optional: Error Tracking (Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

