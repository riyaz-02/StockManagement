# Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection
# ONE database holds everything (the website's `shopmanage`, with the app's collections added). This is the ONLY database
# address: the old SHOPMANAGE_DB_URI / LGP_ADMIN_DB_URI are gone (ignored if still set). It MUST end with the database
# name, or the server refuses to start. Locally use a throw-away database (e.g. /lgp_dev), never the production one.
MONGODB_URI=mongodb://localhost:27017/shopmanage
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopmanage?retryWrites=true&w=majority

# JWT Secret (Change this to a random secure string in production)
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRE=7d
# a phone that signs in from the app (remember:true) or refreshes keeps a long session; its PIN / fingerprint guard the screen
JWT_REMEMBER_EXPIRE=90d

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# CORS
CORS_ORIGIN=*
